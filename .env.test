# Môi trường của `npm test` / `arcade test` — KHÔNG BAO GIỜ trỏ vào DB thật.
# Cùng Postgres/Redis của docker compose nhưng database `arcade_test` và Redis db 1:
# test tạo/xoá người chơi, game, điểm; chạy trên DB thật là để lại "người chơi ma"
# trong bảng xếp hạng castle (13/11/2026). scripts/test-guard.ts chặn nếu lệch.
# Chuẩn bị một lần (và sau mỗi migration mới): npm run test:setup
DATABASE_URL=postgres://arcade:arcade@127.0.0.1:55432/arcade_test
REDIS_URL=redis://127.0.0.1:56379/1

JWT_SECRET=test-only-not-a-secret
ACCESS_TTL_SEC=900
REFRESH_TTL_SEC=7776000
PORT=0
HOST=127.0.0.1
GAMES_DIR=.
LOG_LEVEL=warn
