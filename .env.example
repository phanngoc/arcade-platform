# Cổng lệch chuẩn để không đụng Postgres/Redis khác đang chạy trên máy
DATABASE_URL=postgres://arcade:arcade@127.0.0.1:55432/arcade
REDIS_URL=redis://127.0.0.1:56379

# HS256 ở M0. Đổi sang EdDSA khi tách gateway khỏi api (M2).
JWT_SECRET=dev-only-change-me
ACCESS_TTL_SEC=900
REFRESH_TTL_SEC=7776000

# 8080 đã bị nginx trên máy này chiếm
PORT=8090
HOST=127.0.0.1
GAMES_DIR=.
LOG_LEVEL=info
